# 可选：代理请求上游的「等响应头」超时（毫秒，默认 15000）与重试次数
# 注意：该超时只管到响应头为止；拿到响应头后响应体不再限时（大文件/长视频必需）
REQUEST_TIMEOUT=15000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：放行「内网上游」——自建 AList / OpenList 把网盘转成直链后，通常就在本机或局域网
# （http://192.168.x.x:5244 或 http://127.0.0.1:5244）。默认关闭时，媒体代理与 M3U8 分片
# 会被 SSRF 校验拦下，用户把直链填进课程也播不出来。
#
# ⚠️ 只在「本机使用」或「服务不对外暴露」时打开；公网部署请保持关闭，否则代理会成为
# 内网探测跳板。桌面客户端由主进程在环回地址上承载数据层，因此默认打开（可在客户端设置里关闭）。
# ALLOW_PRIVATE_UPSTREAM=1

# 可选：放行内网直播源（自建 IPTV）。与上面的开关各自独立、互不影响。
# LIVE_ALLOW_PRIVATE=1